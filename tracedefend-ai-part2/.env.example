# PostgreSQL
POSTGRES_DB=tracedefend
POSTGRES_USER=tracedefend
POSTGRES_PASSWORD=change_this_local_postgres_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=tracedefend
RABBITMQ_DEFAULT_PASS=change_this_local_rabbitmq_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO - local development only
MINIO_ROOT_USER=tracedefend
MINIO_ROOT_PASSWORD=change_this_local_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=tracedefend-uploads

# Backend
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
